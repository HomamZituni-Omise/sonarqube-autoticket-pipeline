# Copy to .env and fill in. Do NOT commit .env.
# Required for live runs (not needed for --dry-run --mock).

# --- SonarQube ---
SONAR_BASE_URL=https://sonarqube.example.com
SONAR_TOKEN=your_sonarqube_token_here
# Optional: comma-separated project keys to restrict to. Empty = all projects.
SONAR_PROJECT_KEYS=
# Optional: override triggered severities (default: BLOCKER,CRITICAL).
SONAR_SEVERITIES=

# --- Jira ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your_jira_api_token_here

# --- Ticketing policy (all optional) ---
# Jira project to create tickets in.
JIRA_PROJECT_KEY=SEC
# Optional parent issue key (e.g. an epic). Empty = no parent.
JIRA_PARENT_KEY=
# Optional assignee. Jira Cloud assigns by accountId; display name is informational.
JIRA_ASSIGNEE=
JIRA_ASSIGNEE_ACCOUNT_ID=
# Optional: comma-separated Jira projects to scan for pre-existing coverage
# (cross-reference / overlap detection). Empty = disabled.
JIRA_CROSSREF_PROJECTS=
# Optional: override the "new since" cutoff for ad-hoc testing (YYYY-MM-DD).
SONAR_NEW_SINCE=
